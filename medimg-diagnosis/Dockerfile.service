FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements-service.txt .
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-service.txt
COPY pyproject.toml .
COPY src ./src
RUN pip install --no-deps -e .
ENV DATA_DIR=/data MODEL_CKPT=/models/densenet121_nih.pt
EXPOSE 8000
CMD ["uvicorn", "--factory", "medimg.service.app:create_app", "--host", "0.0.0.0", "--port", "8000"]
